    <p class="note">Se agregará a ${catTipo==='Gasto'?'gastos':'ingresos'}.</p>`,
    [{label:'Cancelar',fn:hide},{label:'Agregar',cls:'p',fn:()=>{const n=$('#cN').value.trim();if(!n){$('#gErr').textContent='Escribe un nombre.';return}
      if(config.categories.some(c=>c.name.toLowerCase()===n.toLowerCase())){$('#gErr').textContent='Ya existe esa categoría.';return}
      config.categories.push({id:uid(),name:n,tipo:catTipo,emoji:$('#cE').value.trim()||'•',budget:0});hide();render();saveConfig()}}]);
  setTimeout(()=>$('#cN').focus(),260);
};

/* ---------- global clicks ---------- */
document.addEventListener('click',e=>{
  const t=e.target.closest('[data-tx],[data-ft],[data-fc],[data-ab],[data-eg],[data-ct],[data-dc]');if(!t)return;
  if(t.dataset.tx){const it=allItems().find(i=>i.id===t.dataset.tx);if(it)openTx(it)}
  else if(t.dataset.ft){filterT=t.dataset.ft;filterC='Todas';render()}
  else if(t.dataset.fc){filterC=t.dataset.fc;render()}
  else if(t.dataset.ab){openTx(null,{tipo:'Ahorro',meta:t.dataset.ab,fecha:todayISO()})}
  else if(t.dataset.eg){goalForm(config.goals.find(g=>g.id===t.dataset.eg))}
  else if(t.dataset.ct){catTipo=t.dataset.ct;render()}
  else if(t.dataset.dc){const c=config.categories.find(c=>c.id===t.dataset.dc);
    confirmBox(`¿Eliminar "${c.name}"?`,'Tus movimientos con esta categoría se conservan.','Eliminar',()=>{config.categories=config.categories.filter(x=>x.id!==c.id);render();saveConfig()})}
});
let budT=null;
document.addEventListener('change',e=>{
  const b=e.target.closest('[data-bud]');if(!b)return;
  const c=config.categories.find(c=>c.id===b.dataset.bud);const v=parseFloat(b.value.replace(/[,$\s]/g,''));
  const nv=v>0?Math.round(v*100)/100:0;if(c.budget===nv)return;c.budget=nv;
  clearTimeout(budT);budT=setTimeout(()=>{saveConfig();toast('Presupuesto guardado')},400);render();
});
$('#fab').onclick=()=>openTx();
$('#prevM').onclick=()=>{view=new Date(view.getFullYear(),view.getMonth()-1,1);render()};
$('#nextM').onclick=()=>{view=new Date(view.getFullYear(),view.getMonth()+1,1);render()};

/* ---------- export ---------- */
function csv(){
  const q=v=>{v=String(v??'');return /[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v};
  const rows=[['ID','Fecha','Tipo','Monto','Categoria','Metodo','Meta','Nota','Destino']];
  sortTx(allItems()).reverse().forEach(i=>{const g=config.goals.find(g=>g.id===i.meta);rows.push([i.id,i.fecha,i.tipo,(+i.monto).toFixed(2),i.cat,accName(accOf(i))||i.metodo,g?g.name:'',i.nota,i.destino?accName(i.destino):''])});
  return rows.map(r=>r.map(q).join(',')).join('\n');
}
$('#cpCsv').onclick=async()=>{try{await navigator.clipboard.writeText(csv());toast('CSV copiado')}catch(e){toast('No se pudo copiar')}};
async function saveFile(name,text,mime){
  try{if(window.claude&&claude.use){const dl=await claude.use('downloads');if(dl){await dl.save({filename:name,data:text});return true}}}catch(e){if(e&&e.code)return false}
  try{const url=URL.createObjectURL(new Blob([text],{type:mime}));const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),4000);return true}
  catch(e){toast('No se pudo descargar; usa el botón de copiar');return false}
}
$('#dlCsv').onclick=()=>saveFile('mis-finanzas-'+todayISO()+'.csv','\ufeff'+csv(),'text/csv');
const backup=()=>JSON.stringify({app:'misfinanzas',v:1,fecha:new Date().toISOString(),config,months});
$('#bkSave').onclick=()=>saveFile('respaldo-mis-finanzas-'+todayISO()+'.json',backup(),'application/json');
$('#bkCopy').onclick=async()=>{try{await navigator.clipboard.writeText(backup());toast('Respaldo copiado')}catch(e){toast('No se pudo copiar')}};
$('#bkLoad').onclick=()=>{
  gSheet('Restaurar respaldo',`<p class="note">Elige el archivo de respaldo o pega su contenido. <b>Reemplaza</b> los datos que hay ahora en esta app.</p>
    <button class="btn sm" id="bkPick" style="margin-bottom:10px">📁 Elegir archivo</button>
    <textarea class="inp" id="bkTxt" rows="4" placeholder="…o pega aquí el respaldo copiado" style="resize:vertical;font-size:12px"></textarea>`,
    [{label:'Cancelar',fn:hide},{label:'Restaurar',cls:'p',fn:()=>restore($('#bkTxt').value)}]);
  $('#bkPick').onclick=()=>$('#bkFile').click();
};
$('#bkFile').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;const t=await f.text();e.target.value='';if($('#bkTxt'))$('#bkTxt').value=t;restore(t)});
function restore(t){
  let o;try{o=JSON.parse(t)}catch(_){ $('#gErr').textContent='Ese texto no es un respaldo válido.';return}
  if(!o||o.app!=='misfinanzas'||!o.config||!o.months){$('#gErr').textContent='Ese archivo no es un respaldo de Mis Finanzas.';return}
  const n=Object.values(o.months).reduce((s,m)=>s+Object.keys((m||{}).items||{}).length,0);
  hide();setTimeout(()=>confirmBox('¿Restaurar este respaldo?',`Trae ${n} movimientos y reemplaza lo que tienes ahora.`,'Restaurar',()=>{
    config=Object.assign(JSON.parse(JSON.stringify(DEFAULT_CONFIG)),o.config);months=o.months;
    render();saveConfig();Object.keys(months).forEach(saveMonth);toast('Respaldo restaurado ✔')}),60);
}

route(); initStore();
try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist()}catch(_){}
if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('sw.js').catch(()=>{}))}
})();
</script>
</body>
