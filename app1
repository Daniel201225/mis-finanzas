<!DOCTYPE html>
<html lang="es">{
 "name": "Mis Finanzas",
 "short_name": "Finanzas",
 "description": "Control personal de gastos, ingresos, cuentas y ahorro",
 "lang": "es",
 "start_url": "./index.html",
 "scope": "./",
 "id": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#f4f1ea",
 "theme_color": "#0f3d2e",
 "categories": [
  "finance",
  "productivity"
 ],
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "shortcuts": [
  {
   "name": "Movimientos",
   "url": "./index.html#movimientos"
  },
  {
   "name": "Análisis",
   "url": "./index.html#analisis"
  }
 ]
}
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0f3d2e">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Mis Finanzas</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="description" content="Control personal de gastos, ingresos, cuentas y ahorro">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f4f1ea; --card:#fffdf8; --ink:#1b1f1d; --muted:#6b706c; --line:#e6e1d6;
  --brand:#0f3d2e; --brand2:#1f6b4f; --accent:#e9b949;
  --in:#1f8a5b; --out:#c2412d; --save:#2d6cb5; --warn:#d98a1c;
  --r:18px; --shadow:0 1px 2px rgba(0,0,0,.04),0 6px 20px rgba(15,61,46,.06);
}
@media (prefers-color-scheme:dark){
  :root{--bg:#101412;--card:#181d1a;--ink:#eef0ec;--muted:#9aa29c;--line:#262d29;--brand:#9fe0bf;--brand2:#5cc093;--shadow:none;--in:#4cc98d;--out:#f07a62;--save:#78a9ec}
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',system-ui,sans-serif;font-size:16px}
body{padding:env(safe-area-inset-top) env(safe-area-inset-right) 0 env(safe-area-inset-left)}
.num{font-variant-numeric:tabular-nums}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
input,select,textarea{font:inherit;color:var(--ink)}
.wrap{max-width:520px;margin:0 auto;padding:16px 16px calc(110px + env(safe-area-inset-bottom))}

/* header */
.top{display:flex;align-items:center;justify-content:space-between;margin:6px 2px 14px}
.top h1{font-size:22px;margin:0;letter-spacing:-.02em}
.monthsel{display:flex;align-items:center;gap:4px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:4px}
.monthsel button{width:30px;height:30px;border-radius:50%;font-size:18px;color:var(--muted)}
.monthsel button:active{background:var(--line)}
.monthsel span{font-weight:600;font-size:14px;min-width:92px;text-align:center;text-transform:capitalize}

/* hero */
.hero{background:var(--brand);color:#f4f1ea;border-radius:24px;padding:20px 20px 18px;position:relative;overflow:hidden}
@media (prefers-color-scheme:dark){.hero{background:#173a2c;color:#eef0ec}}
.hero::after{content:"";position:absolute;right:-40px;top:-40px;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle,rgba(233,185,73,.35),transparent 70%)}
.hero .lbl{font-size:13px;opacity:.75}
.hero .big{font-size:40px;font-weight:700;letter-spacing:-.03em;margin:2px 0 14px}
.hero .row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.hero .row div{background:rgba(255,255,255,.08);border-radius:12px;padding:8px 10px}
.hero .row small{display:block;font-size:11px;opacity:.75}
.hero .row b{font-size:15px}

.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px;margin-top:14px;box-shadow:var(--shadow)}
.card h2{font-size:15px;margin:0 0 12px;display:flex;justify-content:space-between;align-items:center}
.card h2 a,.link{font-size:13px;color:var(--brand2);font-weight:600;text-decoration:none}
.empty{color:var(--muted);font-size:14px;text-align:center;padding:14px 4px}

/* budget bars */
.bud{margin:12px 0}
.bud .t{display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px}
.bud .t span:last-child{color:var(--muted)}
.bar{height:8px;background:var(--line);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:99px;background:var(--in);transition:width .4s}
.bar i.w{background:var(--warn)} .bar i.o{background:var(--out)}

/* donut */
.donut{display:flex;gap:16px;align-items:center}
.donut svg{flex:0 0 132px}
.legend{flex:1;display:flex;flex-direction:column;gap:6px;font-size:13px;min-width:0}
.legend div{display:flex;align-items:center;gap:8px}
.legend i{width:10px;height:10px;border-radius:3px;flex:0 0 10px}
.legend span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* tx list */
.day{font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin:14px 4px 6px}
.tx{display:flex;align-items:center;gap:12px;padding:10px 4px;border-bottom:1px solid var(--line);width:100%;text-align:left}
.tx:last-child{border-bottom:0}
.tx .ic{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;font-size:18px;flex:0 0 38px}
.tx .m{flex:1;min-width:0}
.tx .m b{display:block;font-weight:600;font-size:15px}
.tx .m small{color:var(--muted);font-size:12px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tx .a{font-weight:700;font-size:15px}
.a.Gasto{color:var(--out)} .a.Ingreso{color:var(--in)} .a.Ahorro{color:var(--save)}

/* chips & filter */
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:8px 12px;border-radius:999px;border:1px solid var(--line);background:var(--card);font-size:14px;font-weight:500}
.chip.on{background:var(--brand);border-color:var(--brand);color:#f4f1ea}
@media (prefers-color-scheme:dark){.chip.on{color:#101412}}
.scrollx{overflow-x:auto;flex-wrap:nowrap;padding-bottom:4px;scrollbar-width:none}
.scrollx::-webkit-scrollbar{display:none}
.chip{white-space:nowrap}

/* goals */
.goal{padding:14px 0;border-bottom:1px solid var(--line)}
.goal:last-child{border-bottom:0}
.goal .t{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.goal .t b{font-size:16px}
.goal .sub{font-size:13px;color:var(--muted);margin:4px 0 8px}
.goal .bar i{background:var(--save)}
.goal .acts{display:flex;gap:8px;margin-top:10px}

.btn{padding:12px 16px;border-radius:14px;font-weight:600;background:var(--line)}
.btn.p{background:var(--brand);color:#f4f1ea}
@media (prefers-color-scheme:dark){.btn.p{color:#101412}}
.btn.d{background:transparent;color:var(--out)}
.btn.sm{padding:8px 12px;font-size:14px;border-radius:10px}
.btn.full{width:100%}

/* nav */
nav.bottom{position:fixed;left:0;right:0;bottom:0;background:color-mix(in srgb,var(--card) 92%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--line);padding:6px 8px calc(6px + env(safe-area-inset-bottom));z-index:10}
nav.bottom .in{max-width:520px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr 72px 1fr 1fr;align-items:center}
nav.bottom a{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;color:var(--muted);text-decoration:none;padding:6px 0;font-weight:500}
nav.bottom a svg{width:22px;height:22px}
nav.bottom a.on{color:var(--brand)}
.fab{width:58px;height:58px;border-radius:20px;background:var(--accent);color:#1b1f1d;font-size:30px;font-weight:400;margin:-26px auto 0;box-shadow:0 8px 20px rgba(217,160,40,.4);display:grid;place-items:center}
.fab:active{transform:scale(.95)}

/* sheet */
.scrim{position:fixed;inset:0;background:rgba(10,15,12,.45);opacity:0;pointer-events:none;transition:opacity .2s;z-index:20}
.scrim.on{opacity:1;pointer-events:auto}
.sheet{position:fixed;left:0;right:0;bottom:0;max-width:560px;margin:0 auto;background:var(--card);border-radius:24px 24px 0 0;padding:10px 18px calc(18px + env(safe-area-inset-bottom));transform:translateY(105%);transition:transform .25s cubic-bezier(.2,.8,.2,1);z-index:21;max-height:88vh;max-height:88dvh;overflow-y:auto;overscroll-behavior:contain}
.sheet{visibility:hidden;transition:transform .25s cubic-bezier(.2,.8,.2,1),visibility 0s .25s}
.sheet.on{transform:none;visibility:visible;transition:transform .25s cubic-bezier(.2,.8,.2,1)}
.grab{width:40px;height:5px;border-radius:9px;background:var(--line);margin:0 auto 8px}
.shead{position:sticky;top:-10px;z-index:2;background:var(--card);margin:-10px -18px 12px;padding:10px 12px 10px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--line);touch-action:none}
.shead h3{flex:1;margin:0!important;font-size:17px;text-align:center}
.shead .cls{width:40px;height:40px;border-radius:12px;background:var(--bg);font-size:18px;color:var(--ink);display:grid;place-items:center;flex:0 0 40px}
.shead .sv{padding:10px 14px;border-radius:12px;background:var(--brand);color:#f4f1ea;font-weight:700;font-size:14px;min-width:40px}
.shead .sv.hidden{visibility:hidden;display:block!important}
@media (prefers-color-scheme:dark){.shead .sv{color:#101412}}
.shead .gw{position:absolute;left:50%;top:4px;transform:translateX(-50%);width:36px;height:4px;border-radius:9px;background:var(--line)}
.sheet h3{margin:0 0 14px;font-size:18px}
.seg{display:grid;grid-template-columns:repeat(4,1fr);background:var(--bg);border-radius:14px;padding:4px;gap:4px;margin-bottom:14px}
.seg button{padding:10px 4px;border-radius:10px;font-weight:600;font-size:14px;color:var(--muted)}
.seg button.on{background:var(--card);color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.08)}
.seg button.on[data-t=Gasto]{color:var(--out)} .seg button.on[data-t=Ingreso]{color:var(--in)} .seg button.on[data-t=Ahorro]{color:var(--save)} .seg button.on[data-t=Transferencia]{color:var(--ink)}
.a.Transferencia{color:var(--muted)}
.acc{display:flex;align-items:center;gap:12px;padding:10px 2px;border-bottom:1px solid var(--line);width:100%;text-align:left}
.acc:last-child{border-bottom:0}
.acc .ic{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-size:19px;background:var(--bg);flex:0 0 40px}
.acc .m{flex:1;min-width:0}.acc .m b{display:block;font-size:15px}.acc .m small{color:var(--muted);font-size:12px}
.acc .v{font-weight:700;font-size:16px;text-align:right}.acc .v small{display:block;font-size:11px;font-weight:500;color:var(--muted)}
.tot{display:flex;gap:10px;margin-bottom:6px}.tot div{flex:1;background:var(--bg);border-radius:12px;padding:10px 12px}.tot small{display:block;font-size:12px;color:var(--muted)}.tot b{font-size:20px}
.fchip{display:inline-flex;align-items:center;gap:6px;margin-top:8px}
.amount{display:flex;align-items:center;justify-content:center;gap:4px;margin:6px 0 16px}
.amount span{font-size:30px;color:var(--muted);font-weight:600}
.amount input{border:0;background:transparent;font-size:44px;font-weight:700;width:220px;text-align:center;outline:none;letter-spacing:-.02em}
.field{margin-bottom:14px}
.field>label{display:block;font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px}
.inp{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:var(--bg);outline:none}
.inp:focus{border-color:var(--brand2)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.sheetacts{display:flex;gap:10px;margin-top:8px}
.sheetacts .btn.p{flex:1}
.err{color:var(--out);font-size:13px;min-height:18px;margin-top:-6px;margin-bottom:6px}

/* settings */
.set{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.set:last-child{border-bottom:0}
.set .n{flex:1;font-weight:500}
.set .n small{display:block;color:var(--muted);font-weight:400;font-size:12px}
.set input{width:96px;padding:8px 10px;border-radius:10px;border:1px solid var(--line);background:var(--bg);text-align:right}
.x{width:32px;height:32px;border-radius:10px;color:var(--muted);font-size:18px}
.status{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--warn)}
.dot.ok{background:var(--in)}
.note{font-size:13px;color:var(--muted);line-height:1.45}
.toast{position:fixed;left:50%;bottom:calc(96px + env(safe-area-inset-bottom));transform:translate(-50%,20px);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;font-size:14px;opacity:0;transition:.2s;z-index:30;pointer-events:none}
.toast.on{opacity:1;transform:translate(-50%,0)}
.hidden{display:none!important}
/* v4 */
.search{position:relative;margin-bottom:10px}
.search input{width:100%;padding:12px 14px 12px 40px;border-radius:14px;border:1px solid var(--line);background:var(--card);outline:none}
.search input:focus{border-color:var(--brand2)}
.search svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted)}
.search .clr{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:9px;color:var(--muted)}
.ins{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--line);align-items:flex-start}
.ins:last-child{border-bottom:0}
.ins .e{font-size:20px;width:36px;height:36px;border-radius:11px;background:var(--bg);display:grid;place-items:center;flex:0 0 36px}
.ins p{margin:0;font-size:14px;line-height:1.4}.ins p small{display:block;color:var(--muted);font-size:12px;margin-top:2px}
.kpi{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.kpi div{background:var(--bg);border-radius:12px;padding:10px 12px}.kpi small{display:block;font-size:12px;color:var(--muted)}.kpi b{font-size:19px}
.ant{background:color-mix(in srgb,var(--warn) 12%,var(--card));border-radius:14px;padding:12px 14px;margin:10px 0;font-size:14px;line-height:1.4}
.loan{padding:12px 0;border-bottom:1px solid var(--line)}.loan:last-child{border-bottom:0}
.loan .t{display:flex;justify-content:space-between;gap:8px;align-items:baseline}.loan .t b{font-size:16px}
.loan .sub{font-size:12.5px;color:var(--muted);margin:3px 0 8px}
.loan .bar i{background:var(--brand2)}
.loan .acts{display:flex;gap:8px;margin-top:10px}
.tag{font-size:11px;font-weight:700;padding:3px 8px;border-radius:99px;margin-left:6px;vertical-align:middle}
.tag.in{background:rgba(31,138,91,.14);color:var(--in)}.tag.out{background:rgba(194,65,45,.12);color:var(--out)}
details.closed summary{cursor:pointer;color:var(--muted);font-size:13px;font-weight:600;padding:10px 0 2px}
.sect{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:22px 4px 0}
/* v2 */
.hero{transition:background .4s}
.hero.green{background:#14513a} .hero.blue{background:#1f4f8a} .hero.red{background:#9a2c1f} .hero.none{background:#2f3a35}
@media (prefers-color-scheme:dark){.hero.green{background:#14513a}.hero.blue{background:#1f4f8a}.hero.red{background:#8a2a1e}.hero.none{background:#2a332f}}
.hero::after{z-index:0} .hero>*{position:relative;z-index:1}
.htop{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.htop .big{margin:2px 0 12px}
.pill{font-size:12px;font-weight:700;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.16);white-space:nowrap}
.left{background:rgba(0,0,0,.16);border-radius:16px;padding:12px 14px;margin-bottom:12px}
.left .lt{display:flex;justify-content:space-between;align-items:baseline;gap:8px;font-size:14px;opacity:.95}
.left .lt b{font-size:22px;letter-spacing:-.02em}
.hbar{height:10px;background:rgba(255,255,255,.18);border-radius:99px;overflow:hidden;margin:10px 0 8px}
.hbar i{display:block;height:100%;border-radius:99px;background:#fff;transition:width .5s}
.lmsg{font-size:12.5px;opacity:.85;line-height:1.35}
.tabs2{display:inline-grid;grid-template-columns:1fr 1fr;background:var(--bg);border-radius:10px;padding:3px;gap:3px}
.tabs2 button{padding:5px 10px;border-radius:8px;font-size:12px;font-weight:600;color:var(--muted)}
.tabs2 button.on{background:var(--card);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.chart svg{width:100%;height:auto;display:block}
.chart .bar-hit{cursor:pointer}
.daybox{margin-top:10px;border-top:1px dashed var(--line);padding-top:8px}
.daybox .h{display:flex;justify-content:space-between;font-size:14px;font-weight:600;margin:4px 4px 2px}
.tx{gap:10px}
.ed{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;color:var(--muted);flex:0 0 34px}
.ed:active{background:var(--line)}
.tx .a small{display:block;font-size:10px;font-weight:600;color:var(--save);text-align:right}
.day{display:flex;justify-content:space-between}
.hint{font-size:12px;color:var(--muted);text-align:center;margin:8px 0 0}
.banner{display:flex;gap:12px;align-items:center;background:color-mix(in srgb,var(--accent) 22%,var(--card));border:1px solid color-mix(in srgb,var(--accent) 50%,var(--line));border-radius:var(--r);padding:12px 14px;margin-top:14px}
.banner p{margin:0;flex:1;font-size:14px;line-height:1.35}
.sw{position:relative;width:46px;height:28px;flex:0 0 46px}
.sw input{opacity:0;width:0;height:0}
.sw span{position:absolute;inset:0;background:var(--line);border-radius:99px;transition:.2s}
.sw span::after{content:"";position:absolute;width:22px;height:22px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.sw input:checked+span{background:var(--brand2)}
.sw input:checked+span::after{transform:translateX(18px)}
.chk{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;background:var(--bg);margin-bottom:14px}
.chk .tx2{flex:1;font-size:14px}
.chk .tx2 small{display:block;color:var(--muted);font-size:12px}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1 id="title">Mis Finanzas</h1>
    <div class="monthsel">
      <button id="prevM" aria-label="Mes anterior">‹</button>
      <span id="monthLbl" class="num"></span>
      <button id="nextM" aria-label="Mes siguiente">›</button>
    </div>
  </div>

  <!-- INICIO -->
  <section id="v-inicio">
    <div class="hero" id="hero">
      <div class="htop">
        <div><div class="lbl" id="hLbl">Gastos del mes</div><div class="big num" id="hOut">$0.00</div></div>
        <span class="pill" id="hPill"></span>
      </div>
      <div class="left">
        <div class="lt"><span id="hLeftLbl">Te queda de tus ingresos</span><b class="num" id="hLeft"></b></div>
        <div class="hbar"><i id="hBarI"></i></div>
        <div class="lmsg" id="hMsg"></div>
      </div>
      <div class="row">
        <div><small id="hTodayLbl">Hoy</small><b class="num" id="hToday">$0</b></div>
        <div><small>Ahorraste</small><b class="num" id="hSave">$0</b></div>
        <div><small>Ingresos</small><b class="num" id="hIn">$0</b></div>
      </div>
    </div>
    <div id="nudge"></div>
    <div id="recBanner"></div>
    <div class="card"><h2>Mis cuentas <button class="link" id="addAcc">+ Agregar</button></h2><div id="accounts"></div></div>
    <div class="card"><h2><span id="chTitle">Gastos por día</span><span class="tabs2" id="chTabs"><button data-ch="dia">Día</button><button data-ch="mes">Mes</button></span></h2>
      <div class="chart" id="chart"></div><div id="dayBox"></div></div>
    <div class="card" id="budCard"><h2>Límites del mes <a href="#ajustes">Editar</a></h2><div id="budgets"></div></div>
    <div class="card"><h2>¿En qué se va mi dinero?</h2><div id="donut"></div></div>
