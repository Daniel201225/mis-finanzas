<div class="toast" id="toast"></div>

<script>
(function(){
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=n=>(n<0?'-':'')+'$'+Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
const fmt0=n=>(n<0?'-':'')+'$'+Math.abs(n).toLocaleString('en-US',{maximumFractionDigits:0});
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const pad=n=>String(n).padStart(2,'0');
const todayISO=()=>{const d=new Date();return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())};
const mkey=iso=>'m-'+iso.slice(0,7);
const MESES=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const DIAS=['dom','lun','mar','mié','jue','vie','sáb'];
const COLORS=['#1f6b4f','#e9b949','#c2412d','#2d6cb5','#8a5cc2','#d9772b','#3aa39a','#b5487a','#7d8a3a','#5b6670'];

const DEFAULT_CONFIG={
  categories:[
    {id:'c1',name:'Comida',tipo:'Gasto',emoji:'🍔',budget:0},
    {id:'c2',name:'Transporte',tipo:'Gasto',emoji:'🚌',budget:0},
    {id:'c3',name:'Universidad',tipo:'Gasto',emoji:'🎓',budget:0},
    {id:'c4',name:'Salidas',tipo:'Gasto',emoji:'🎉',budget:0},
    {id:'c5',name:'Servicios',tipo:'Gasto',emoji:'💡',budget:0},
    {id:'c6',name:'Personal',tipo:'Gasto',emoji:'🧴',budget:0},
    {id:'c7',name:'Salud',tipo:'Gasto',emoji:'💊',budget:0},
    {id:'c8',name:'Otros gastos',tipo:'Gasto',emoji:'📦',budget:0},
    {id:'c9',name:'Trabajo',tipo:'Ingreso',emoji:'💼',budget:0},
    {id:'c10',name:'Apoyo familiar',tipo:'Ingreso',emoji:'🤝',budget:0},
    {id:'c11',name:'Otros ingresos',tipo:'Ingreso',emoji:'💵',budget:0}
  ],
  goals:[],
  methods:['Efectivo','Tarjeta','Transferencia'],
  accounts:[{id:'a-cash',name:'Efectivo',type:'efectivo',bank:'',initial:0}],
  useBudgets:false,
  loans:[],
  antTh:5,
  recurring:[]
};

/* ---------- state ---------- */
let config=JSON.parse(JSON.stringify(DEFAULT_CONFIG));
let months={};              // key -> {items:{id:item}}
let view=new Date(); view.setDate(1);
let filterT='Todos', filterC='Todas', filterA='', catTipo='Gasto', lastAcc='';

/* ---------- storage ---------- */
let db=null, uref=null, mode='init';
const LS='misfinanzas.v1';
function lsLoad(){try{const o=JSON.parse(localStorage.getItem(LS)||'null');if(o){config=Object.assign(JSON.parse(JSON.stringify(DEFAULT_CONFIG)),o.config||{});months=o.months||{}}}catch(e){}}
function lsSave(){try{localStorage.setItem(LS,JSON.stringify({config,months}))}catch(e){}}
const queues={};
function writeDoc(id,body){
  if(mode!=='db'){lsSave();return Promise.resolve()}
  const prev=queues[id]||Promise.resolve();
  const p=prev.catch(()=>{}).then(async()=>{
    try{ await uref.doc(id).set(body) }
    catch(e){
      if(e&&e.code==='unavailable'){await new Promise(r=>setTimeout(r,600+Math.random()*800));await uref.doc(id).set(body)}
      else{toast(e&&e.code==='quota_exceeded'?'Espacio lleno: no se pudo guardar':'No se pudo guardar. Intenta de nuevo.');throw e}
    }
  });
  queues[id]=p; lsSave(); return p;
}
const saveConfig=()=>writeDoc('config',config);
const saveMonth=k=>writeDoc(k,months[k]||{items:{}});

async function initStore(){
  lsLoad(); render();
  try{
    throw 0; // versión instalada: solo almacenamiento local
    const [d,u]=await Promise.all([claude.use('db'),claude.use('user')]);
    const id=u?await u.id():null;
    if(!d||!id) throw 0;
    db=d; uref=db.collection('data/users/'+id); mode='db';
    let first=true;
    uref.onSnapshot(snap=>{
      const nm={}; let cfg=null;
      snap.docs.forEach(doc=>{const b=doc.data(); if(doc.id==='config')cfg=b; else if(doc.id.startsWith('m-'))nm[doc.id]=b});
      if(first && snap.empty && !snap.metadata.fromCache){
        // primera vez en la nube: subir lo que hubiera guardado localmente
        first=false;
        const hasLocal=Object.keys(months).length;
        if(hasLocal){saveConfig();Object.keys(months).forEach(saveMonth);toast('Datos locales subidos a tu cuenta')}
        setStatus(); return;
      }
      if(!snap.metadata.fromCache) first=false;
      if(cfg) config=Object.assign(JSON.parse(JSON.stringify(DEFAULT_CONFIG)),JSON.parse(JSON.stringify(cfg)));
      if(!snap.empty) months=JSON.parse(JSON.stringify(nm));
      lsSave(); render(); setStatus();
    },err=>{mode='local';setStatus()});
  }catch(e){ mode='local' }
  setStatus();
}
function setStatus(){
  const ok=mode==='db';
  $('#stDot').classList.toggle('ok',ok);
  $('#stTxt').textContent=ok?'Guardado en tu cuenta de Claude. Lo ves igual en el celular y en la compu, y solo tú tienes acceso.'
    : mode==='init'?'Cargando…':'Tus datos se guardan solo en este celular, funcionan sin internet y nadie más los ve. Guarda un respaldo de vez en cuando (arriba) por si cambias o pierdes el celular.';
}

/* ---------- data helpers ---------- */
function allItems(){const a=[];for(const k in months){const it=(months[k]||{}).items||{};for(const id in it)a.push(it[id])}return a}
function monthItems(d=view){const k='m-'+d.getFullYear()+'-'+pad(d.getMonth()+1);return Object.values(((months[k]||{}).items)||{})}
const catOf=name=>config.categories.find(c=>c.name===name);
const sum=(arr,t)=>arr.filter(i=>!t||i.tipo===t).reduce((s,i)=>s+(+i.monto||0),0);
const sortTx=a=>a.sort((x,y)=>(y.fecha.localeCompare(x.fecha))||((y.ts||0)-(x.ts||0)));
function colorFor(name){const i=config.categories.filter(c=>c.tipo==='Gasto').findIndex(c=>c.name===name);return COLORS[(i<0?9:i)%COLORS.length]}
function iconFor(i){if(i.tipo==='Ahorro')return '🐷';if(i.tipo==='Transferencia')return '🔁';const c=catOf(i.cat);return c?c.emoji:'•'}

/* ---------- cuentas ---------- */
const ATYPE={efectivo:{n:'Efectivo',e:'💵'},banco:{n:'Cuenta de banco',e:'🏦'},credito:{n:'Tarjeta de crédito',e:'💳'}};
const accs=()=>config.accounts||[];
const accById=id=>accs().find(a=>a.id===id);
const accOf=i=>i.cuenta||(i.metodo==='Efectivo'?'a-cash':'');
const accName=id=>{const a=accById(id);return a?a.name:(id?'Cuenta eliminada':'')};
function accDelta(id){let d=0;allItems().forEach(i=>{const m=+i.monto||0;const from=accOf(i);
  if(from===id){if(i.tipo==='Ingreso')d+=m;else d-=m}
  if(i.destino===id&&(i.tipo==='Transferencia'||i.tipo==='Ahorro'))d+=m});
  (config.loans||[]).forEach(l=>{const sg=l.tipo==='preste'?-1:1;if(l.cuenta===id)d+=sg*(+l.monto||0);(l.pagos||[]).forEach(p=>{if(p.cuenta===id)d-=sg*(+p.monto||0)})});
  return d}
const accBal=a=>(+a.initial||0)+accDelta(a.id);
function renderAccounts(){
  const L=accs();let cash=0,debt=0;
  const rows=L.map(a=>{const b=accBal(a);if(a.type==='credito'){if(b<0)debt+=-b}else cash+=b;
    const t=ATYPE[a.type]||ATYPE.banco;
    const val=a.type==='credito'?(b<0?`<span style="color:var(--out)">${fmt(-b)}</span><small>Debes</small>`:`${fmt(b)}<small>A favor</small>`)
      :`<span style="${b<0?'color:var(--out)':''}">${fmt(b)}</span><small>Disponible</small>`;
    return `<div class="acc"><button class="ic" data-eacc="${a.id}" aria-label="Editar cuenta">${t.e}</button>
      <button class="m" data-facc="${a.id}" style="text-align:left"><b>${esc(a.name)}</b><small>${esc([t.n,a.bank].filter(Boolean).join(' · '))} · ver movimientos</small></button>
      <div class="v num">${val}</div></div>`}).join('');
  $('#accounts').innerHTML=`<div class="tot"><div><small>Dinero disponible</small><b class="num">${fmt(cash)}</b></div>${debt>0?`<div><small>Deuda en tarjetas</small><b class="num" style="color:var(--out)">${fmt(debt)}</b></div>`:''}</div>${rows}
    <p class="hint" style="text-align:left">Toca el ícono para editar o ajustar el saldo.</p>`;
}
function accForm(a){
  const isNew=!a; a=a||{id:'a-'+uid(),name:'',type:'banco',bank:'',initial:0};
  let type=a.type;
  const cur=isNew?0:accBal(a);
  const paint=()=>{document.querySelectorAll('#aT .chip').forEach(b=>b.classList.toggle('on',b.dataset.at===type));
    $('#aBalLbl').textContent=type==='credito'?'¿Cuánto debes hoy en la tarjeta?':'¿Cuánto dinero tienes hoy en esta cuenta?';
    $('#aBankW').classList.toggle('hidden',type==='efectivo')};
  gSheet(isNew?'Nueva cuenta':'Editar cuenta',`
    <div class="field"><label>Tipo</label><div class="chips" id="aT">${Object.entries(ATYPE).map(([k,v])=>`<button class="chip" data-at="${k}">${v.e} ${v.n}</button>`).join('')}</div></div>
    <div class="field"><label>Nombre</label><input class="inp" id="aN" value="${esc(a.name)}" placeholder="Ej. Cuenta de ahorro, Tarjeta débito" maxlength="30"></div>
    <div class="field" id="aBankW"><label>Banco (opcional)</label><input class="inp" id="aB" value="${esc(a.bank||'')}" placeholder="Ej. Agrícola, BAC, Cuscatlán" maxlength="30"></div>
    <div class="field"><label id="aBalLbl"></label><input class="inp num" id="aV" inputmode="decimal" value="${isNew?'':(a.type==='credito'?Math.max(0,-cur):cur).toFixed(2)}" placeholder="$ 0.00"></div>
    <p class="note">Desde aquí, cada gasto, ingreso o movimiento que hagas con esta cuenta actualiza su saldo solo.${type==='credito'?'':''}</p>`,
    [...(isNew||a.id==='a-cash'?[]:[{label:'Eliminar',cls:'d',fn:()=>confirmBox(`¿Eliminar "${a.name}"?`,'Tus movimientos se conservan, pero ya no sumarán a ninguna cuenta.','Eliminar',()=>{config.accounts=accs().filter(x=>x.id!==a.id);render();saveConfig()})}]),
     {label:'Cancelar',fn:hide},
     {label:'Guardar',cls:'p',fn:()=>{const n=$('#aN').value.trim();if(!n){$('#gErr').textContent='Ponle un nombre.';return}
       let v=parseFloat(($('#aV').value||'0').replace(/[,$\s]/g,''));if(isNaN(v)){$('#gErr').textContent='Escribe un monto válido.';return}
       const target=type==='credito'?-Math.abs(v):v;
       Object.assign(a,{name:n,type,bank:type==='efectivo'?'':$('#aB').value.trim()});a.initial=Math.round((target-accDelta(a.id))*100)/100;
       if(isNew)config.accounts=[...accs(),a];hide();render();saveConfig();toast(isNew?'Cuenta agregada':'Cuenta actualizada')}}]);
  paint();
  $('#aT').onclick=e=>{const b=e.target.closest('[data-at]');if(b){type=b.dataset.at;paint()}};
  if(isNew)setTimeout(()=>$('#aN').focus(),260);
}
$('#addAcc').onclick=()=>accForm();
document.addEventListener('click',e=>{const b=e.target.closest('[data-eacc],[data-facc],[data-clra]');if(!b)return;
  if(b.dataset.eacc)accForm(accById(b.dataset.eacc));
  else if(b.dataset.facc){filterA=b.dataset.facc;filterT='Todos';filterC='Todas';location.hash='#movimientos';render()}
  else {filterA='';render()}});

/* ---------- render ---------- */
function render(){
  $('#monthLbl').textContent=MESES[view.getMonth()].slice(0,3)+' '+view.getFullYear();
  const items=monthItems();
  const inc=sum(items,'Ingreso'),out=sum(items,'Gasto'),sav=sum(items,'Ahorro');
  const isCur=viewKey()===mkey(todayISO());
  $('#hLbl').textContent=isCur?'Gastos del mes':'Gastos de '+MESES[view.getMonth()];
  $('#hOut').textContent=fmt(out);
  const left=inc-out-sav, hero=$('#hero');
  hero.classList.remove('green','blue','red','none');
  if(inc>0){
    const pct=left/inc, st=pct>=.7?'green':pct>=.3?'blue':'red';
    hero.classList.add(st);
    $('#hLeftLbl').textContent='Te queda de tus ingresos';
    $('#hLeft').textContent=fmt(left);
    $('#hBarI').style.width=Math.max(0,Math.min(100,pct*100))+'%';
    $('#hPill').textContent=(left<0?'Sin fondos':Math.round(pct*100)+'% disponible');
    $('#hMsg').textContent=left<0?`Gastaste y apartaste ${fmt(-left)} más de lo que entró este mes.`
      :st==='green'?`Vas bien: conservas la mayor parte de tus ${fmt(inc)} de ingresos.`
      :st==='blue'?`Punto medio: ya usaste ${Math.round((1-pct)*100)}% de tus ingresos. Cuida los gastos.`
      :`Te estás quedando sin dinero: solo queda ${Math.round(pct*100)}% de tus ingresos.`;
    $('#hMsg').title='Gastos y ahorro se descuentan de tus ingresos.';
  }else{
    hero.classList.add('none');
    $('#hLeftLbl').textContent='Te queda de tus ingresos';
    $('#hLeft').textContent='—';
    $('#hBarI').style.width='0%';
    $('#hPill').textContent='Sin ingresos';
    $('#hMsg').textContent='Registra un ingreso (+ → Ingreso) para ver cuánto te queda y el color de tu mes.';
  }
  if(isCur){$('#hTodayLbl').textContent='Hoy';$('#hToday').textContent=fmt0(sum(items.filter(i=>i.fecha===todayISO()),'Gasto'))}
  else{const dd=new Set(items.filter(i=>i.tipo==='Gasto').map(i=>i.fecha)).size;$('#hTodayLbl').textContent='Promedio/día';$('#hToday').textContent=fmt0(out/daysIn(view))}
  $('#hIn').textContent=fmt0(inc);$('#hSave').textContent=fmt0(sav);

  renderBanner(items); renderChart(items); renderRec(); renderAccounts(); renderInsights(); renderAnts(); renderLoans(); renderNudge(items);
  $('#useBud').checked=!!config.useBudgets;

  // budgets
  const withB=config.categories.filter(c=>c.tipo==='Gasto'&&c.budget>0);
  $('#budCard').classList.toggle('hidden',!(config.useBudgets&&withB.length));
