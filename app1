    if(hv>0)g+=`<rect x="${x}" y="${pt+chh-hv}" width="${w}" height="${hv}" rx="${Math.min(3,w/2)}" fill="${col}"/>`;
    if(hs>0)g+=`<rect x="${x}" y="${pt+chh-hv-hs}" width="${w}" height="${Math.max(0,hs-1)}" rx="${Math.min(3,w/2)}" fill="var(--save)"/>`;
    if(b.lbl)g+=`<text x="${x+w/2}" y="${H-5}" text-anchor="middle" font-size="10" fill="${isT||sel?'var(--ink)':'var(--muted)'}" ${isT?'font-weight="700"':''}>${b.lbl}</text>`;
    if(chMode==='dia')g+=`<rect class="bar-hit" data-day="${b.k}" x="${pl+4+i*bw}" y="${pt}" width="${bw}" height="${chh+pb}" fill="transparent"/>`;
  });
  let leg=chMode==='mes'?`<div class="legend" style="flex-direction:row;gap:14px;margin-top:6px"><div><i style="background:var(--brand2)"></i>Gastos</div><div><i style="background:var(--save)"></i>Ahorro</div></div>`:'';
  $('#chart').innerHTML=`<svg viewBox="0 0 ${W} ${H}">${g}</svg>${leg}`;
  // detalle del día
  if(chMode==='dia'){
    if(!selDay||!selDay.startsWith(viewKey().slice(2)))selDay=viewKey()===mkey(t)?t:null;
    const di=sortTx(items.filter(i=>i.fecha===selDay));
