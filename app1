let chMode='dia', selDay=null;
function renderChart(items){
  document.querySelectorAll('#chTabs button').forEach(b=>b.classList.toggle('on',b.dataset.ch===chMode));
  const W=340,H=150,pl=34,pb=20,pt=10,cw=W-pl-4,chh=H-pb-pt;
  let bars=[],labels=[];
  if(chMode==='dia'){
    $('#chTitle').textContent='Gastos por día';
    const n=daysIn(view),vk=view.getFullYear()+'-'+pad(view.getMonth()+1);
    for(let d=1;d<=n;d++){const iso=vk+'-'+pad(d);bars.push({k:iso,v:sum(items.filter(i=>i.fecha===iso),'Gasto'),s:0,lbl:(d===1||d%5===0)?String(d):''})}
  }else{
