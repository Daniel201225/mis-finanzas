function renderInsights(){
  const cur=monthItems(),prevD=new Date(view.getFullYear(),view.getMonth()-1,1),prev=monthItems(prevD);
  const g=cur.filter(i=>i.tipo==='Gasto'),gp=prev.filter(i=>i.tipo==='Gasto');
  const out=sum(g),outP=sum(gp),L=[];
  const mN=MESES[view.getMonth()],pN=MESES[prevD.getMonth()];
  const isCur=viewKey()===mkey(todayISO());
  const daysSoFar=isCur?new Date().getDate():daysIn(view);
  if(!g.length){$('#insights').innerHTML='<div class="empty">Cuando registres gastos este mes, aquí verás tus patrones.</div>';return}
  // vs mes anterior
  if(outP>0){
    if(isCur){const outPsame=sum(gp.filter(i=>+i.fecha.slice(8)<=daysSoFar));
      if(outPsame>0){const ch=(out-outPsame)/outPsame;L.push([ch>0?'📈':'📉',`Llevas ${fmt(out)} gastados, ${Math.abs(Math.round(ch*100))}% ${ch>0?'más':'menos'} que a estas alturas de ${pN}.`,`A día ${daysSoFar} de ${pN} llevabas ${fmt(outPsame)}.`])}}
    else{const ch=(out-outP)/outP;L.push([ch>0?'📈':'📉',`Gastaste ${Math.abs(Math.round(ch*100))}% ${ch>0?'más':'menos'} que en ${pN}.`,`${fmt(out)} en ${mN} contra ${fmt(outP)} en ${pN}.`])}
  }
  // categoría principal
  const by={},byP={};g.forEach(i=>by[i.cat]=(by[i.cat]||0)+(+i.monto));gp.forEach(i=>byP[i.cat]=(byP[i.cat]||0)+(+i.monto));
  const top=Object.entries(by).sort((a,b)=>b[1]-a[1])[0];
  L.push([(catOf(top[0])||{}).emoji||'🏷️',`Donde más gastas es en ${top[0]}: ${fmt(top[1])}.`,`Es el ${Math.round(top[1]/out*100)}% de tus gastos del mes.`]);
  // mayor aumento por categoría
  if(gp.length){let best=null;for(const c in by){const d=by[c]-(byP[c]||0);if(d>0&&(!best||d>best[1]))best=[c,d]}
    if(best&&best[1]>=1)L.push(['⚠️',`${best[0]} subió ${fmt(best[1])} respecto a ${pN}.`,`Pasaste de ${fmt(byP[best[0]]||0)} a ${fmt(by[best[0]])}.`]);}
  // día de la semana (últimos 90 días)
  const since=new Date();since.setDate(since.getDate()-90);const sI=since.toISOString().slice(0,10);
  const dw=[0,0,0,0,0,0,0];allItems().filter(i=>i.tipo==='Gasto'&&i.fecha>=sI).forEach(i=>dw[new Date(i.fecha+'T12:00').getDay()]+=(+i.monto));
  const totW=dw.reduce((a,b)=>a+b,0);
  if(totW>0){const mx=dw.indexOf(Math.max(...dw));const DL=['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
    L.push(['📅',`Tu día de más gasto es el ${DL[mx]}.`,`Ahí se va el ${Math.round(dw[mx]/totW*100)}% de lo que gastas (últimos 90 días).`])}
  // promedio y proyección
  const avg=out/daysSoFar;
  L.push(['🧮',`Gastas en promedio ${fmt(avg)} al día.`,isCur?`A ese ritmo, cerrarías ${mN} en unos ${fmt(avg*daysIn(view))}.`:`En total fueron ${g.length} gastos en ${mN}.`]);
  // días sin gastar
  const dset=new Set(g.map(i=>i.fecha));const free=daysSoFar-[...dset].filter(d=>+d.slice(8)<=daysSoFar).length;
  if(free>0)L.push(['🌱',`Tuviste ${free} día${free>1?'s':''} sin gastar nada.`,'Cada día sin gastos cuenta.']);
