  let g='';
  for(let y=0;y<=top+1e-9;y+=step){const yy=pt+chh-(y/top)*chh;g+=`<line x1="${pl}" x2="${W}" y1="${yy}" y2="${yy}" stroke="var(--line)" stroke-width="1"/><text x="${pl-6}" y="${yy+4}" text-anchor="end" font-size="10" fill="var(--muted)">$${y}</text>`}
  const bw=cw/bars.length,gap=chMode==='dia'?Math.max(1.5,bw*.25):bw*.32;
  const t=todayISO();
