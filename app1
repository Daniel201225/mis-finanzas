      ${di.length?di.map(i=>txRow(i)).join(''):'<div class="empty" style="padding:8px">Sin movimientos este día.</div>'}</div>`
      :'<p class="hint">Toca una barra para ver los gastos de ese día.</p>';
  } else $('#dayBox').innerHTML='';
}
