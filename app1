      bars.push({k:'M'+m,v:sum(it,'Gasto'),s:sum(it,'Ahorro'),lbl:MESES[d.getMonth()].slice(0,3),cur:m===0})}
  }
  const max=Math.max(1,...bars.map(b=>b.v+b.s));
